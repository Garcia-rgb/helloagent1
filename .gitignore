# 教程本体：它自己是独立 git 仓库，不纳入本仓库
/Hello-Agents/

# 早期 ZIP 快照（约 176 MB），保留但不跟踪
/hello-agents-main/

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 密钥
.env

# 本地模型权重（1.2 GB 起，绝不入库；用 tools/fetch_model.py 重新拉）
/models/
.hf-cache/

# 助手工作记忆（环境约定 / 排障日志），含本机细节，不公开
.workbuddy/

# 临时诊断文件（命名约定：以下划线开头）
_*
*.log

# 各章运行输出（随时可重跑生成，不必入库）
runs/
